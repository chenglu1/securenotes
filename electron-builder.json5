/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.chenglud.securenotes",
  "asar": true,
  "asarUnpack": [
    // wasm 文件需要在 asar 外访问
    "**/*.wasm"
  ],
  "protocols": [
    {
      "name": "SecureNotes",
      "schemes": [
        "securenotes"
      ]
    }
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "node_modules",
    // 排除不必要的文件，减小包体积
    "!**/*.map",
    "!**/*.md",
    "!**/test/**",
    "!**/tests/**",
    "!**/__tests__/**",
    "!**/LICENSE*",
    "!**/CHANGELOG*",
    "!**/.npmignore"
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ]
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}",
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
