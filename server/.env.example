# Neon PostgreSQL 数据库配置示例
# 复制此文件为 .env 并填入真实值
# 推荐直接使用 Neon 控制台提供的 pooled connection string

DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require

# 如果你不想直接使用 DATABASE_URL，也可以分开配置
DB_HOST=<pooled-host>
DB_PORT=5432
DB_USER=<user>
DB_PASSWORD=<password>
DB_NAME=<database>

# JWT 密钥
JWT_SECRET=your-random-secret-key

# Google OAuth 桌面登录配置
# 回调地址需要与 Google Cloud Console 中配置的 OAuth Redirect URI 完全一致
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 如果你本机通过 Clash、V2Ray、Surge 等本地代理访问 Google，可按需配置
# HTTPS_PROXY=http://127.0.0.1:7897

# 是否自动同步数据库结构
# 本地开发可不填；Render 学习部署可设置为 true
DB_SYNCHRONIZE=false

# 服务器端口
PORT=3000

# 环境
NODE_ENV=development
